function scheduleCell(room,day,per,week,editable){const st=scheduleStatus(room,day,per,week);const now=dayOf(liveCtx().date)===Number(day)&&liveCtx().period===per;return `<button type="button" class="schedule-cell ${st} ${now?'now':''} ${editable?'editable':''}" ${editable?`data-schedule-edit="${esc(room)}" data-schedule-period="${per}"`:''} title="${esc(room)}・第${per}節・${scheduleDescription(st)}">${scheduleDescription(st)}</button>`}
