let sectionObserver=null;function activateEffects(){const host=$('app');if(!host)return;const blocks=[...host.querySelectorAll('.hero,.participate,.section-head,.metrics,.leaderboard-panel,.closing-impact,.card,.schedule-shell')];if(!('IntersectionObserver' in window)||window.matchMedia('(prefers-reduced-motion: reduce)').matches){blocks.forEach(x=>x.classList.add('visible'));return}sectionObserver?.disconnect();const o=new IntersectionObserver(entries=>{for(const item of entries)if(item.isIntersecting){const element=item.target;element.classList.add('visible');o.unobserve(element);element.querySelectorAll('.count-up').forEach(counter=>{const target=Number(counter.dataset.target);if(!Number.isFinite(target)||target<=0)return;const start=performance.now(),end=620;const update=now=>{const progress=Math.min(1,(now-start)/end);counter.textContent=String(Math.round(target*(1-(1-progress)**3)));if(progress<1)requestAnimationFrame(update)};requestAnimationFrame(update)})}}, {threshold:0.08,rootMargin:'0px 0px -25px 0px'});sectionObserver=o;blocks.forEach(x=>{x.classList.add('reveal');o.observe(x)})}
