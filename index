if(adminTab==='users')return `<div class="card"><h2>示範帳號與節能幣</h2><p class="muted">查看每位使用者的身分、回報數量、志工巡查數與節能幣；若需調整，使用「節能幣」管理分頁。</p><div class="table-wrap"><table><thead><tr><th>使用者</th><th>身分</th><th>自主回報</th><th>正式巡查</th><th>節能幣</th><th>操作</th></tr></thead><tbody>${Object.entries(accounts).map(([id,a])=>`<tr><td>${esc(a.name)}<br><span class="muted">${id}</span></td><td>${a.role==='student'?'學生':a.role==='volunteer'?'志工':'管理員'}</td><td>${state.reports.filter(r=>r.user===id&&r.valid).length}</td><td>${state.inspections.filter(r=>r.user===id&&r.valid).length}</td><td><b>${E.balance(state,id)}</b></td><td>${a.role==='admin'?'—':`<button class="btn small light" data-adjust-user="${id}">調整節能幣</button>`}</td></tr>`).join('')}</tbody></table></div></div>`;
if(adminTab==='rooms')return timetablePanel('admin')+`<section class="card"><h2>教室與設備</h2><p class="muted">列表已按樓層由高至低排序。可調整設備、中央空調標記與是否開放回報。</p><div class="table-wrap"><table><thead><tr><th>樓層</th><th>教室</th><th>容量</th><th>電燈</th><th>冷氣</th><th>電腦</th><th>中央空調</th><th>開放</th></tr></thead><tbody>${state.rooms.map(r=>`<tr><td>${r.floor}</td><td>${esc(r.id)}</td><td>${r.capacity||'—'}</td>${E.devices.map(d=>`<td><input aria-label="${esc(r.id)} ${E.names[d]}設定" type="checkbox" data-room-config="${esc(r.id)}" data-device="${d}" ${r.equipment.includes(d)?'checked':''}></td>`).join('')}<td><input aria-label="${esc(r.id)} 中央空調" type="checkbox" data-room-config="${esc(r.id)}" data-device="central" ${r.central?'checked':''}></td><td><input aria-label="${esc(r.id)} 開放" type="checkbox" data-room-config="${esc(r.id)}" data-device="active" ${r.active?'checked':''}></td></tr>`).join('')}</tbody></table></div></section>`;
if(adminTab==='patrols')return `<div class="card"><h2>正式志工巡查</h2><p class="muted"></p>${adminFilters()}${activityTable(filtered(state.inspections),'admin')}</div>`;
if(adminTab==='reports')return `<div class="card"><h2>待辦：紀錄錯誤舉報</h2>${issueList()}</div><div class="card"><h2>學生回報與改善</h2>${adminFilters()}${activityTable(filtered(state.reports),'admin')}</div><div class="card"><h2>耗能事件狀態</h2><div class="event-filter"><label>狀態<select id="event-status-filter"><option value="all">全部狀態</option>${['待處理','部分完成','已完成節能'].map(v=>`<option value="${v}" ${eventStatusFilter===v?'selected':''}>${v}</option>`).join('')}</select></label><label>教室<select id="event-room-filter"><option value="">全部教室</option>${roomOptions(eventRoomFilter)}</select></label><label>日期<input type="date" id="event-date-filter" value="${eventDateFilter}"></label><button type="button" class="btn small light" data-action="export-events">匯出 CSV ↓</button></div>${eventRows().length?eventRows().map(e=>`<div class="admin-item"><div class="room-top"><b>${esc(e.room)} · ${e.date} · ${e.period} 節</b>${badge(e)}</div><p>發現：${e.open.map(d=>E.names[d]).join('、')} ／ 已關閉：${e.closed.map(d=>E.names[d]).join('、')||'無'}</p><button class="btn small light" data-edit-event="${e.id}">更正處理狀態</button></div>`).join(''):noData('目前沒有符合條件的耗能事件。')}</div>`;
return `<div class="card"><h2>節能幣調整</h2><p class="muted">調整須留下原因；不會讓餘額小於零。無效回報的既發獎勵，請在此撤回。</p><form id="coin-form"><div class="form-grid"><label class="field">示範帳號<select name="user">${Object.entries(accounts).filter(([,v])=>v.role!=='admin').map(([k,v])=>`<option value="${k}">${v.name}（${E.balance(state,k)} 枚）</option>`).join('')}</select></label><label class="field">調整枚數（可負數）<input name="amount" type="number" step="1" min="-5000" max="5000" required></label></div><label class="field">調整原因<input name="reason" maxlength="120" required placeholder="例如：撤回無效回報獎勵"></label><button class="btn small">確認調整</button></form></div><div class="card"><h2>完整獎勵明細</h2>${state.ledger.length?`<div class="table-wrap"><table><thead><tr><th>時間</th><th>帳號</th><th>原因</th><th>枚數</th></tr></thead><tbody>${[...state.ledger].reverse().map(l=>`<tr><td>${time(l.time)}</td><td>${esc(person(l.user))}</td><td class="wrap">${esc(l.reason)}</td><td>${l.amount>0?'+':''}${l.amount}</td></tr>`).join('')}</tbody></table></div>`:noData()}</div>`}
let adminDate='',adminPeriod='',adminRoom='',eventStatusFilter='all',eventRoomFilter='',eventDateFilter='',issueDraft=null;
function adminFilters(){return `<form id="admin-filter" class="toolbar"><label class="field">日期<input type="date" name="date" value="${adminDate}"></label><label class="field">節次<select name="period"><option value="">全部</option>${periods.map(p=>`<option ${p===adminPeriod?'selected':''}>${p}</option>`).join('')}</select></label><label class="field">教室<select name="room"><option value="">全部</option>${roomOptions(adminRoom)}</select></label><button class="btn small light">篩選</button></form>`}
