function patrol(){if(current()?.role!=='volunteer')return gate('志工專屬巡查','請切換志工示範帳號，記錄完整的現場觀察。');return head('VOLUNTEER FIELDWORK','每次巡查，都讓資料更完整。','志工回報為正式巡查紀錄，可參考課表規劃巡查動線。')+timetablePanel('volunteer')+`<div class="layout"><section class="card"><form id="patrol-form">${liveBar()}<label class="field" style="margin-top:16px">當天巡查節次<select id="patrol-period">${periodOptions(liveCtx().period)}</select></label>${`<label class="field">週別<select id="context-week"><option value="odd" ${ctx.week==='odd'?'selected':''}>單週</option><option value="even" ${ctx.week==='even'?'selected':''}>雙週</option></select></label>`}<label class="field">卓越大樓教室<select id="patrol-room">${roomOptions('602')}</select></label><div id="patrol-schedule" class="callout">${scheduleText('602')}</div><div class="form-grid"><label class="field">課表該節是否有課<select id="patrol-scheduled"><option value="no">未排課</option><option value="yes">有課</option><option value="unknown">不確定</option></select></label><label class="field">實際使用情況<select id="patrol-empty"><option value="yes">無人</option><option value="no">有人</option></select></label><label class="field">現場人數<input type="number" id="patrol-people" min="0" max="500" value="0"></label><label class="field">供電情況<select id="patrol-power"><option value="normal">一般供電</option><option value="auto">自動斷電</option></select></label></div><p>記錄發現時的設備狀態</p>${E.devices.map(d=>`<label class="device-row" data-patrol-device="${d}"><b>${E.names[d]}</b><select id="patrol-${d}"><option value="off">原本已關閉</option><option value="open">開啟，未關閉</option><option value="closed">開啟，已協助關閉</option></select></label>`).join('')}<label class="field" style="margin-top:18px">備註（選填）<textarea id="patrol-note" maxlength="200" placeholder="如實記錄即可，不必推測原因"></textarea></label><div id="form-error" role="alert" style="color:#a55528"></div><button class="btn" type="submit">送出正式巡查 ✓</button></form></section><aside><div class="card"><h3>巡查小提醒</h3><ul class="help-list"><li>課表有課，也要確認現場實際課堂狀況。</li><li>正常、無人且設備關閉，都可送出。</li><li>自動斷電直接選「自動斷電」。</li><li>已有學生回報，仍可正式巡查。</li><li>資料直接納入統計，無須逐筆審核。</li></ul><a class="textlink" href="#mine">查看我的志工貢獻 →</a></div></aside></div>`}
function mine(){if(!user)return gate('我的節能幣','你的每一次參與，都值得留下。');const ledger=state.ledger.filter(l=>l.user===user),reports=state.reports.filter(r=>r.user===user),v=state.inspections.filter(r=>r.user===user&&r.valid);return head('MY LITTLE IMPACT',esc(current().name)+'的永續足跡','每一枚節能幣都有原因，每一次巡查都有貢獻。')+`<section class="coin-head"><div><small>我的節能幣</small><strong>${E.balance(state,user)}</strong> 枚<small>感謝你為校園節能付出的每一次行動！</small></div><span style="font-size:65px;color:#d9f292">ϟ</span></section>${current().role==='volunteer'?`<div class="metrics">${metric('正式巡查',v.length,'次')}${metric('發現異常',v.filter(r=>r.empty&&r.open.length).length,'次')}${metric('完成改善',v.filter(r=>r.empty&&r.open.length&&r.closed.length===r.open.length).length,'次')}${metric('巡查獎勵',0,'枚',true,'正式巡查不領幣')}</div>`:''}<div class="policy-note"><b>節能幣與活動規範</b><p>本頁節能幣屬網站測試及展示紀錄，非正式核發之實際節能幣。若經查證有錯誤、虛假或違反規則之回報，管理者得依規定撤銷該筆紀錄並扣回相關節能幣；多次不實或惡意回報者，得停止其參與及獎勵資格。活動規則、爭議及個案由主辦團隊依公告辦法審認與處理。</p></div><div class="section-head"><h2>節能幣明細</h2><a href="#report" class="textlink">再做一點改變 ↗</a></div><div class="card">${ledger.length?`<div class="table-wrap"><table><thead><tr><th>時間</th><th>原因</th><th>節能幣</th></tr></thead><tbody>${[...ledger].reverse().map(l=>`<tr><td>${time(l.time)}</td><td class="wrap">${esc(l.reason)}</td><td><b>${l.amount>=0?'+':''}${l.amount}</b></td></tr>`).join('')}</tbody></table></div>`:noData('還沒有節能幣，完成第一筆有效學生回報即可累積。')}</div><div class="section-head"><h2>自主回報紀錄</h2></div><div class="card">${activityTable(reports)}</div>${current().role==='volunteer'?`<div class="section-head"><h2>正式巡查紀錄</h2></div><div class="card">${activityTable(v)}</div>`:''}`}
function statsPage(){const t=E.stats(state);return monthPanel()+head('OUR SHARED IMPACT','把觀察，變成改變的證據。','整合巡查觀察、能源改善與校園參與，讓每一次行動都能成為可追蹤的成果。')+`<div class="section-head"><div><span class="eyebrow">01 / EMPTY CLASSROOMS</span><h2>空教室，哪些設備仍在空轉？</h2></div></div><div class="card"><p class="muted">以下整合有效的學生回報與志工巡查，依教室、日期及節次去除重複，統計各設備被發現開啟的事件數。管理後台更正後會同步更新。</p>${E.devices.map(d=>`<div class="bar-row"><b>${E.names[d]}</b><div class="bar"><div style="width:${t.events?t.device[d]/t.events*100:0}%"></div></div><span>${t.device[d]} 件</span></div>`).join('')}<p class="muted">${t.events?'同一事件可能包含多種設備，因此各設備件數不應相加為總件數。':'目前尚無有效設備開啟紀錄。'}</p></div><div class="section-head"><div><span class="eyebrow">02 / ENERGY IMPROVEMENT</span><h2>發現浪費，一起完成改善。</h2></div></div><div class="metrics">${metric('確認耗能事件',t.events,'件')}${metric('已完成節能',t.done,'件',true)}${metric('未完成／部分完成',t.events-t.done,'件')}${metric('完成率',t.events?Math.round(t.done/t.events*100):'—',t.events?'%':'',false,'分母為去重後異常事件')}</div><div class="callout">事件識別：同一日期＋節次＋教室。正常使用、未發現異常不建立異常事件；志工巡查與學生回報筆數不直接相加。</div><div class="section-head"><div><span class="eyebrow">03 / CAMPUS PARTICIPATION</span><h2>參與，讓節能走得更遠。</h2></div></div><div class="metrics">${metric('學生有效回報',t.reports,'筆')}${metric('自主參與人數',t.participants,'人')}${metric('累積節能幣',t.coins,'枚',true,'含管理者調整的淨發放量')}${metric('納入巡查空間',state.rooms.filter(r=>r.active).length,'間')}</div><div class="buttons" style="margin-top:24px"><button class="btn line" data-action="export-stats">匯出成果 CSV ↓</button></div>`}
function about(){return head('ABOUT THE PROJECT','節盡全力，不讓能源白白空轉。','中國醫藥大學校園節能行動平台。結合學生自主參與、志工定期巡查與改善紀錄，讓更多人一起減少不必要的能源消耗。')+`<div class="layout"><section class="card"><h2>從看見浪費，到真正改變。</h2><p>當教室沒有上課、使用人數很少，電燈、冷氣或電腦卻仍持續運轉，無形中就可能累積不必要的能源消耗。我們希望不只停留在「看見問題」，更能鼓勵大家「採取行動」：記下現場能源使用情況、在適當情況下隨手關閉設備，讓每一次改善都被看見。</p><p>透過團隊前期調查、志工定期巡查，以及師生的自主節能回報，逐步建立校園能源使用紀錄。管理者維護資料，課表則協助志工安排巡查路線；判斷現場情形仍以實際觀察為準。</p><div class="buttons"><span class="pill">SDG 7 可負擔的潔淨能源</span><span class="pill">SDG 13 氣候行動</span></div><h3 style="margin-top:30px">巡查範圍</h3><p class="muted">目前以中國醫藥大學卓越大樓為起點，涵蓋 B2、1F、2F、4F、6F，共 21 處巡查空間，未來可逐步拓展至其他大樓。</p></section><aside class="card"><span class="eyebrow">ACTION ROADMAP</span><h2>我們的執行路徑</h2><div class="timeline"><article><h3>01 · 團隊前期調查</h3><p>先了解校園教室的能源使用情況，整理問題與巡查方向。</p></article><article><h3>02 · 志工定期巡查</h3><p>由志工進行一段期間的巡查與紀錄，建立較完整的觀察資料。</p></article><article><h3>03 · 全校共同參與</h3><p>開放學生自主回報與改善；志工持續協助巡查與確認現場狀況。</p></article><article><h3>04 · 彙整成果與持續改善</h3><p>統整回報、巡查與改善紀錄，讓校園節能成果清楚可見。</p></article></div></aside></div>`}
function admin(){if(current()?.role!=='admin')return gate('管理後台','請切換管理者示範帳號。');const tabs=[['overview','管理總覽'],['rooms','教室與課表'],['patrols','志工巡查'],['reports','學生回報'],['coins','節能幣'],['users','使用者管理']];return head('PROJECT MANAGEMENT','讓每一筆行動，都有依據。','志工紀錄直接納入統計；管理者可修正資料、處理錯誤舉報及調整獎勵。')+`<div class="tabbar">${tabs.map(([k,n])=>`<button class="${adminTab===k?'active':''}" data-admin-tab="${k}">${n}</button>`).join('')}</div>${adminContent()}`}
