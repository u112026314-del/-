}
function scheduleStatus(room,day,period,week){const all=state.schedule.filter(s=>s.room===room&&Number(s.day)===Number(day)&&String(s.period)===String(period)&&(s.week==='all'||s.week===week));const exact=all.filter(s=>s.week===week);const entries=exact.length?exact:all;if(!entries.length)return builtinScheduleStatus(room,day,period,week);if(entries.some(s=>s.busy==='uncertain'||s.busy==='unknown'))return 'uncertain';return entries.some(s=>s.busy===true||s.busy==='yes')?'busy':'free'}
