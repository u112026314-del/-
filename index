function reconcileEnergyEvent(date,period,room){const k=[date,period,room].join('|'),e=state.events.find(e=>e.key===k);if(e?.manual)return;const source=[...state.inspections,...state.reports].filter(r=>r.valid&&r.date===date&&r.period===period&&r.room===room&&(r.suitable||r.empty));const opened=[...new Set(source.flatMap(r=>r.open||[]))],closed=[...new Set(source.flatMap(r=>r.closed||[]))].filter(d=>opened.includes(d));if(!opened.length){state.events=state.events.filter(v=>v.key!==k);return}if(e){e.open=opened;e.closed=closed;e.time=new Date().toISOString()}else state.events.push({id:E.uid(),key:k,room,date,period,open:opened,closed,time:new Date().toISOString()})}function revokeInvalidReward(record){if(record.valid)return;const awarded=state.ledger.filter(l=>l.report===record.id).reduce((n,l)=>n+l.amount,0);if(awarded>0)state.ledger.push({id:E.uid(),user:record.user,report:record.id,event:record.event,amount:-awarded,type:'adjustment',reason:'撤銷無效回報獎勵',time:new Date().toISOString()})}
